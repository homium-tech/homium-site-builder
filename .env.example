# Credenciales de acceso
AUTH_USER=admin@homium.co
AUTH_PASS=tu_contraseña_segura

# Secreto de sesión (genera uno con: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
SESSION_SECRET=cambia_esto_por_un_valor_aleatorio_largo

# Puerto y host (opcional)
# PORT=8080
# HOST=0.0.0.0

# Dominios/proxies públicos adicionales desde los que se accede a la app (separados por coma)
# Necesario si expones la app con un dominio distinto de localhost/127.0.0.1 (ej. detrás de un puente/proxy)
# ALLOWED_ORIGINS=http://apps.homium.tech:8080,https://apps.homium.tech

# Ventana de contexto (en tokens) de los motores que no la informan, para el medidor "100k / 1M" de la pestaña Consola
# Claude, Ollama y llama.cpp la reportan solos; AGY y OpenCode no
# CONTEXT_WINDOW_AGY=1000000
# CONTEXT_WINDOW_OPENCODE=200000
